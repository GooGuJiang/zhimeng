# 《织梦》环境变量模板 —— 复制为 .env 后填写（.env 已被 git 忽略，切勿提交真实密钥）
# 阿里云百炼 (DashScope) API Key：https://bailian.console.aliyun.com/?apiKey=1
# 留空则后端自动进入「本地兜底模板」模式，全流程仍可演示
DASHSCOPE_API_KEY=

# 1 = 强制兜底模式（不调用任何远程模型，适合离线演示 / CI）
ZM_FORCE_FALLBACK=0
# 数据目录（SQLite / ChromaDB / 生成的插画与配音），默认 backend/data
# ZM_DATA_DIR=./backend/data

# 可选：模型覆盖（默认值见 backend/app/config.py）
# CHAT_MODEL=qwen-plus
# FAST_MODEL=qwen-turbo
# EMBEDDING_MODEL=text-embedding-v3
# IMAGE_MODEL=wanx2.1-t2i-turbo
# TTS_MODEL=qwen-tts

# 端口与代理
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Next.js 将 /api/* 与 /static/* 反向代理到此地址（密钥只存在于后端）
BACKEND_ORIGIN=http://localhost:8000

# ZM_DISABLE_IMAGE=1  不调用百炼生图，只返回占位 SVG（省费；QA 真实模式测试请开启）。配音与大模型不受影响；设为 0 才会真实生图
ZM_DISABLE_IMAGE=1
