# 《织梦》环境变量模板 —— 复制为 .env 后填写（.env 已被 git 忽略，切勿提交真实密钥）
# 阿里云百炼 (DashScope) API Key：https://bailian.console.aliyun.com/?apiKey=1
# 留空则后端自动进入「本地兜底模板」模式，全流程仍可演示
DASHSCOPE_API_KEY=

# 1 = 强制兜底模式（不调用任何远程模型，适合离线演示 / CI）
ZM_FORCE_FALLBACK=0
# 数据目录（SQLite / ChromaDB / 生成的插画与配音），默认 backend/data
# ZM_DATA_DIR=./backend/data

# 可选：模型覆盖（默认值见 backend/app/config.py）
# CHAT_MODEL=qwen-plus
# FAST_MODEL=qwen-turbo
# EMBEDDING_MODEL=text-embedding-v3
# IMAGE_MODEL=wanx2.1-t2i-turbo
# TTS_MODEL=qwen3-tts-flash   # 旧名 qwen-tts 会被自动映射到 qwen3-tts-flash

# 延迟预算 / 超时（秒，默认值见 backend/app/config.py）
# 非流式 LLM 调用（学习小结/记忆问答/抽取/测验）总时限，超时走本地兜底
# SYNC_LLM_TIMEOUT_S=8.0
# 安全审核单次 LLM 调用时限，超时退回关键词/规则层
# GUARD_TIMEOUT_S=6.0
# 回合中叙事前的世界/角色 Agent 预算，超时用本地规则（保首字延迟）
# AGENT_BUDGET_S=2.0
# 记忆向量检索预算，超时跳过检索
# RETRIEVAL_BUDGET_S=1.2
# 关键场景插画/配音在回合流中最多等待的秒数，超时先给 pending 占位、后台原地升级（同 id）
# KEY_SCENE_MEDIA_DEADLINE_S=3

# 管理员令牌：GET /api/reports 不带 world_id 查看全量举报时需请求头 X-Admin-Token 与之一致；留空 = 禁用全量列表
# 请自行生成随机串，切勿提交真实值
ZM_ADMIN_TOKEN=

# ---------------- 账号系统（feat/auth）----------------
# 1 = 必须登录（匿名访问世界/资产/个人中心接口返回 401）；0 = 匿名请求按演示账号 demo 处理（过渡期默认，上线前建议改 1）
ZM_AUTH_REQUIRED=0
# JWT 签名密钥：留空则首次启动自动生成 64 字节并保存到 $ZM_DATA_DIR/jwt_secret（0600），之后沿用；更换会让所有登录失效。切勿提交真实值
# ZM_JWT_SECRET=
# 演示账号 demo 的密码：留空则随机生成并写入 $ZM_DATA_DIR/demo_password.txt（0600），日志只打印路径
# ZM_DEMO_PASSWORD=
# 会话有效期：access 分钟 / refresh 天
# ZM_ACCESS_TTL_MIN=30
# ZM_REFRESH_TTL_DAYS=30
# 1 = cookie 加 Secure（仅 https 可用）；本地 http 开发保持 0
ZM_COOKIE_SECURE=0
# 写接口校验 Origin 白名单（逗号分隔，不能用 *）；用其他域名/IP/端口访问前端时要加进来
# ZM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 只在对端为本机（Next 代理）时采信 X-Forwarded-For（用于登录/注册限流按真实 IP 计数）
# ZM_TRUST_PROXY=1
# 头像上限（字节）/ 同 IP 每小时注册上限
# ZM_AVATAR_MAX_BYTES=2097152
# ZM_REGISTER_PER_HOUR=10

# 端口与代理
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Next.js 将 /api/* 与 /static/* 反向代理到此地址（密钥只存在于后端）
BACKEND_ORIGIN=http://localhost:8000
# Next 反向代理超时（毫秒，默认 180000）；Next 16 默认 30s 会导致长请求 socket hang up（BUG-007）。改后需重新 build/启动前端
# ZM_PROXY_TIMEOUT_MS=180000

# ZM_DISABLE_IMAGE=1  不调用百炼生图，只返回占位 SVG（省费；QA 真实模式测试请开启）。配音与大模型不受影响；设为 0 才会真实生图
ZM_DISABLE_IMAGE=1

# 可见 AI 标识开关（用户要求默认隐藏）。0 = 界面不渲染「内容由AI生成」/「AI 编排」徽标，海报/短视频不印标识，
# 占位插画不写角标，万相生图不加 "AI生成" 水印；ai_generated/ai_label 字段与 ai_meta / PNG 隐式元数据始终保留。
# 1 = 恢复全部可见标识。前端为构建期变量 NEXT_PUBLIC_ZM_SHOW_AI_LABEL（compose 由此值传入）。
# ZM_IMAGE_WATERMARK 可单独覆盖水印。
ZM_SHOW_AI_LABEL=0
