# Copy to backend/.env (never commit .env). Real process env vars take precedence.
# Alibaba Cloud Bailian / DashScope key (https://bailian.console.aliyun.com/ → API-KEY)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
CHAT_MODEL=qwen-plus
FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
IMAGE_MODEL=wanx2.1-t2i-turbo
TTS_MODEL=qwen-tts
TTS_VOICE=Cherry
# Optional
# ZM_FORCE_FALLBACK=1        # run fully offline with templates + hash embeddings
# ZM_DATA_DIR=./data         # SQLite db, chroma index, generated assets
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHAPTER_SIZE=5
NPC_BATCH_EVERY=3
